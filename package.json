{
  "name": "editor-v2",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "A fast, offline-capable playground for HTML, CSS and JavaScript.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
