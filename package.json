    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@emmetio/codemirror6-plugin": "^0.4.1",
    "@lezer/highlight": "^1.2.3",
    "@replit/codemirror-vim": "^6.4.0",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
